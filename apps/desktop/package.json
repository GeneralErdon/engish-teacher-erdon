{
  "name": "@voice-tutor/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "test:cov": "vitest run --coverage",
    "types": "openapi-typescript openapi.json -o src/generated/api.d.ts",
    "types:live": "openapi-typescript ${VT_API_URL:-http://localhost:8080}/openapi.json -o src/generated/api.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
