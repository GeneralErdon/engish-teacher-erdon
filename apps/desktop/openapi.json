{
  "components": {
    "schemas": {
      "ApiKeyPolicy": {
        "enum": [
          "required",
          "optional"
        ],
        "type": "string"
      },
      "CefrLevel": {
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ],
        "type": "string"
      },
      "ConnectionTestRequest": {
        "additionalProperties": false,
        "description": "Body of `POST /v1/llm/test`.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Base Url",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "base_url",
          "model"
        ],
        "title": "ConnectionTestRequest",
        "type": "object"
      },
      "ConnectionTestResult": {
        "additionalProperties": false,
        "description": "Body of `POST /v1/llm/test`. A failed test is a normal result (`ok=False`), not an error.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ConnectionTestResult",
        "type": "object"
      },
      "ExplanationLanguage": {
        "enum": [
          "english",
          "native"
        ],
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Body of `GET /healthz`.",
        "properties": {
          "service": {
            "enum": [
              "api",
              "pron"
            ],
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LearnerProfile": {
        "additionalProperties": false,
        "description": "What the learner can change from the UI. Body of `PUT /v1/learner`.",
        "properties": {
          "explanations": {
            "$ref": "#/components/schemas/ExplanationLanguage"
          },
          "level": {
            "$ref": "#/components/schemas/CefrLevel"
          }
        },
        "required": [
          "level",
          "explanations"
        ],
        "title": "LearnerProfile",
        "type": "object"
      },
      "LearnerProfileView": {
        "additionalProperties": false,
        "description": "Body of `GET`/`PUT /v1/learner`.",
        "properties": {
          "explanations": {
            "$ref": "#/components/schemas/ExplanationLanguage"
          },
          "level": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "native_language": {
            "title": "Native Language",
            "type": "string"
          },
          "source": {
            "enum": [
              "environment",
              "saved"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "level",
          "explanations",
          "native_language",
          "source"
        ],
        "title": "LearnerProfileView",
        "type": "object"
      },
      "LlmSettingsView": {
        "additionalProperties": false,
        "description": "Body of `GET`/`PUT /v1/llm/settings`.",
        "properties": {
          "active": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderSettingsView"
            },
            "title": "Providers",
            "type": "array"
          },
          "source": {
            "enum": [
              "environment",
              "saved"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "active",
          "source",
          "providers"
        ],
        "title": "LlmSettingsView",
        "type": "object"
      },
      "ModelList": {
        "additionalProperties": false,
        "description": "Body of `POST /v1/llm/models`: model ids exactly as the provider expects them, sorted.",
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": false,
        "description": "Error body (`{\"detail\": ...}`), as FastAPI's `HTTPException` renders it.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ProviderConnection": {
        "additionalProperties": false,
        "description": "Enough to reach a provider: body of `POST /v1/llm/models`.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Base Url",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          }
        },
        "required": [
          "kind",
          "base_url"
        ],
        "title": "ProviderConnection",
        "type": "object"
      },
      "ProviderInfo": {
        "additionalProperties": false,
        "description": "One entry of `GET /v1/llm/providers`: what the settings form needs to render a preset.",
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/ApiKeyPolicy"
          },
          "api_key_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Url"
          },
          "base_url_hint": {
            "title": "Base Url Hint",
            "type": "string"
          },
          "default_base_url": {
            "title": "Default Base Url",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/WireProtocol"
          },
          "suggested_model": {
            "title": "Suggested Model",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "label",
          "description",
          "protocol",
          "default_base_url",
          "base_url_hint",
          "api_key",
          "api_key_url",
          "suggested_model"
        ],
        "title": "ProviderInfo",
        "type": "object"
      },
      "ProviderKind": {
        "enum": [
          "ollama",
          "ollama_cloud",
          "openai",
          "anthropic",
          "gemini",
          "openai_compatible",
          "anthropic_compatible"
        ],
        "type": "string"
      },
      "ProviderSettingsInput": {
        "additionalProperties": false,
        "description": "Body of `PUT /v1/llm/settings`: save this provider and make it the active one.\n\n`api_key`: `None` keeps the saved key, `\"\"` removes it, anything else replaces it.",
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "base_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Base Url",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "base_url",
          "model"
        ],
        "title": "ProviderSettingsInput",
        "type": "object"
      },
      "ProviderSettingsView": {
        "additionalProperties": false,
        "description": "A provider's saved settings, without the key.",
        "properties": {
          "api_key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key Hint"
          },
          "api_key_set": {
            "title": "Api Key Set",
            "type": "boolean"
          },
          "base_url": {
            "title": "Base Url",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProviderKind"
          },
          "model": {
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "base_url",
          "model",
          "api_key_set",
          "api_key_hint"
        ],
        "title": "ProviderSettingsView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WireProtocol": {
        "enum": [
          "openai",
          "ollama",
          "anthropic"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "title": "voice-tutor api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness only. Readiness (every model endpoint reachable) arrives with the container.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/learner": {
      "get": {
        "operationId": "get_learner_v1_learner_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerProfileView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Learner",
        "tags": [
          "learner"
        ]
      },
      "put": {
        "operationId": "save_learner_v1_learner_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearnerProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerProfileView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Learner",
        "tags": [
          "learner"
        ]
      }
    },
    "/v1/llm/models": {
      "post": {
        "description": "The provider's models. POST because the body may carry an API key.",
        "operationId": "list_models_v1_llm_models_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderConnection"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "List Models",
        "tags": [
          "llm"
        ]
      }
    },
    "/v1/llm/providers": {
      "get": {
        "description": "Every supported provider, in display order.",
        "operationId": "list_providers_v1_llm_providers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderInfo"
                  },
                  "title": "Response List Providers V1 Llm Providers Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Providers",
        "tags": [
          "llm"
        ]
      }
    },
    "/v1/llm/settings": {
      "delete": {
        "description": "Forget the settings saved from the UI, API keys included; the environment applies.",
        "operationId": "reset_settings_v1_llm_settings_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmSettingsView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Reset Settings",
        "tags": [
          "llm"
        ]
      },
      "get": {
        "operationId": "get_settings_v1_llm_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmSettingsView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Settings",
        "tags": [
          "llm"
        ]
      },
      "put": {
        "description": "Save a provider's settings and make it the active one.",
        "operationId": "save_settings_v1_llm_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderSettingsInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmSettingsView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Incomplete settings"
          }
        },
        "summary": "Save Settings",
        "tags": [
          "llm"
        ]
      }
    },
    "/v1/llm/test": {
      "post": {
        "description": "Ask the model for one short sentence and time it.",
        "operationId": "test_connection_v1_llm_test_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionTestResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Connection",
        "tags": [
          "llm"
        ]
      }
    }
  }
}
