# voice-tutor configuration. Copy to `.env` and adjust:  cp .env.example .env
# Every VT_* variable is validated at startup; a bad value stops the service with a clear error.
# Full reference: docs/configuration.md. Hardware guide: docs/hardware.md.

# ---------------------------------------------------------------- Hardware profile
# cpu | nvidia | amd | external. `just up`, `just dev` and `just models` use it as the
# Docker Compose profile.
VT_PROFILE=cpu

# ---------------------------------------------------------------- api server
# Bind address and port are fixed by compose.yaml (127.0.0.1:8080 on the host); see
# docs/configuration.md before changing VT_HOST / VT_PORT.
VT_LOG_LEVEL=INFO
# Origins allowed to call the api from another origin (JSON list, keep the single quotes).
# The defaults cover the desktop app on every OS and the Vite dev server.
# VT_CORS_ORIGINS='["tauri://localhost","http://tauri.localhost","http://localhost:1420"]'
# Built UI to serve in browser mode. The Docker image sets it to /app/ui.
# VT_UI_DIR=

# ---------------------------------------------------------------- Chat model
# Defaults until you pick a provider in the app (Settings -> Language model), which wins.
# ollama | ollama_cloud | openai | anthropic | gemini | openai_compatible | anthropic_compatible
# (base URLs per provider: docs/configuration.md#chat-model-providers)
VT_LLM_PROVIDER=openai_compatible
VT_LLM_BASE_URL=http://llm:8080/v1
# Name the endpoint expects. With llama.cpp (cpu / amd profiles) it is the alias it serves.
VT_LLM_MODEL=gemma-3-4b-it-q4
# Providers that need a key.
VT_LLM_API_KEY=
VT_LLM_TEMPERATURE=0.6
# llama.cpp only (read by compose.yaml, not by the api): GGUF repository on Hugging Face
# and context size. CPU: a 3-4B model. 12-16 GB GPU: ggml-org/gemma-3-12b-it-GGUF.
VT_LLM_HF_REPO=ggml-org/gemma-3-4b-it-GGUF
VT_LLM_CTX_SIZE=8192
# `external` profile: your own Ollama on the host, for example
# VT_LLM_PROVIDER=ollama
# VT_LLM_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------- Speech-to-text
# openai (Speaches / any OpenAI-compatible server) | whispercpp
VT_STT_BACKEND=openai
VT_STT_BASE_URL=http://stt:8000/v1
# CPU: small.en (fast, less accurate). GPU: large-v3-turbo.
VT_STT_MODEL=small.en

# ---------------------------------------------------------------- Text-to-speech (Kokoro)
VT_TTS_BASE_URL=http://tts:8880/v1
VT_TTS_VOICE=af_heart
# Slightly slower than normal helps learners.
VT_TTS_SPEED=0.95

# ---------------------------------------------------------------- Pronunciation service
# Where the api reaches pron.
VT_PRON_BASE_URL=http://pron:8001
# The pron service itself (its own VT_PRON_ prefix, so it can share this file).
VT_PRON_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Voice activity detection
# Silero speech probability threshold (0-1).
VT_VAD_THRESHOLD=0.5
# Silence that ends a turn.
VT_VAD_MIN_SILENCE_MS=600

# ---------------------------------------------------------------- Learner
# Native language (ISO 639-1): explanations and typical errors.
VT_LEARNER_L1=es
# Starting level: A1 | A2 | B1 | B2 | C1 | C2
VT_LEARNER_LEVEL=B1

# ---------------------------------------------------------------- Storage and privacy
# Paths inside the api container (./data on the host). Point VT_NOTES_DIR at an Obsidian
# vault by mounting it there.
VT_NOTES_DIR=/data/notes
VT_DB_PATH=/data/progress.db
# Settings saved from the app, API keys included (file mode 0600).
VT_SETTINGS_PATH=/data/settings.json
# Keep raw audio for debugging. Off by default: audio is discarded after each turn.
VT_KEEP_AUDIO=false
